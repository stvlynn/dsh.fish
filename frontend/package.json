{
  "name": "@dsh-fish/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Feature-Sliced Design frontend for dsh.fish, served from the same Cloudflare Worker as the API.",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "og:build": "node scripts/build-og-image.mjs",
    "indexnow:submit": "node scripts/indexnow-submit.mjs",
    "preview": "pnpm run build && vite preview",
    "typecheck": "react-router typegen && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "deploy": "node scripts/deploy-production.mjs",
    "deploy:built": "node scripts/deploy-production.mjs --built",
    "cf-typegen": "wrangler types ./.wrangler/worker-configuration.d.ts --include-runtime false",
    "db:migrate:local": "wrangler d1 migrations apply dsh-fish-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply dsh-fish-db --remote",
    "db:seed:local": "wrangler d1 execute dsh-fish-db --local --file ../backend/scripts/seed-local.sql",
    "build:node": "DSH_RUNTIME=node react-router build && vite build --config vite.server.config.ts",
    "start": "node build/node/index.js"
  },
  "dependencies": {
    "@dsh-fish/backend": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@number-flow/react": "^0.6.2",
    "@phosphor-icons/react": "^2.1.10",
    "@primer/octicons-react": "^19.33.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "better-auth": "^1.6.29",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.14.5",
    "fumadocs-mdx": "^15.3.0",
    "hono": "^4.13.2",
    "isbot": "^5.1.22",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10",
    "react-router": "^8.3.0",
    "remark-gfm": "^4",
    "satori": "^0.29.0",
    "simple-icons": "^16.28.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/workers-types": "^5.20260811.1",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.42.0"
  }
}
