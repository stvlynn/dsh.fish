{
  "name": "dsh-fish",
  "version": "0.1.0",
  "private": true,
  "description": "Discover and install DeepSeek Harness plugins, skills, agent presets, bundles, and profiles.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "plugin-registry",
    "ai-agents"
  ],
  "homepage": "https://dsh.fish",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stvlynn/dsh.fish.git"
  },
  "license": "MIT",
  "scripts": {
    "check": "pnpm -r --parallel run typecheck && pnpm run lint && pnpm run test",
    "typecheck": "pnpm -r --parallel run typecheck && tsc -p e2e/tsconfig.json",
    "test": "pnpm -r run test && node --experimental-strip-types --test e2e/lib/worker-config.test.ts",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build": "pnpm --filter @dsh-fish/frontend run build",
    "dev": "pnpm --filter @dsh-fish/frontend run dev",
    "deploy": "pnpm --filter @dsh-fish/frontend run deploy",
    "db:generate": "pnpm --filter @dsh-fish/backend run db:generate",
    "db:migrate:local": "pnpm --filter @dsh-fish/frontend run db:migrate:local",
    "db:migrate:remote": "pnpm --filter @dsh-fish/frontend run db:migrate:remote",
    "docs:check": "node scripts/check-doc-links.mjs",
    "publish:cli": "pnpm --filter @dsh-fish/hub run build && pnpm --filter @dsh-fish/cli publish --access public",
    "publish:hub": "pnpm --filter @dsh-fish/hub run build && pnpm --filter @dsh-fish/hub publish --access public"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "neverBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@cloudflare/workers-types": "^5.20260815.1"
    }
  }
}
