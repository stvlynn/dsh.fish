{
  "name": "dsh-hub",
  "version": "0.1.0",
  "description": "Search dsh.fish and install any harness artifact from inside your agent, authenticated with your hub account.",
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "dsh",
    "deepseek-harness",
    "registry"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stvlynn/dsh.fish.git",
    "directory": "packages/dsh-plugin-hub"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepare": "tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsdown": "^0.15.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
