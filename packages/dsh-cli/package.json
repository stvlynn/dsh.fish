    "lib",
    "README.md"
  ],
  "homepage": "https://dsh.fish",
  "bugs": {
    "url": "https://github.com/stvlynn/dsh.fish/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stvlynn/dsh.fish.git",
    "directory": "packages/dsh-cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
