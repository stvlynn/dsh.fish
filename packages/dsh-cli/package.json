{
  "name": "@dsh-fish/cli",
  "version": "0.3.0",
  "description": "Install dsh.fish artifacts from the command line — the same plan the website shows and the hub plugin executes.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cli",
    "registry",
    "skills"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
